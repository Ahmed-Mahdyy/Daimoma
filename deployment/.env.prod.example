# Production environment template — copy to deployment/.env.prod on the server.
# Never commit deployment/.env.prod or reuse development secrets.

DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-50-char-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=daimoma.example.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://daimoma.example.com
DJANGO_SECURE_SSL_REDIRECT=1

# Loopback port on the Ubuntu host that Nginx proxies to
APP_PORT=8080

# Private PostgreSQL container credentials
POSTGRES_DB=daimoma
POSTGRES_USER=daimoma
POSTGRES_PASSWORD=replace-with-strong-db-password
DATABASE_URL=postgres://daimoma:replace-with-strong-db-password@db:5432/daimoma

# Email transport (console backend for synthetic demo; switch to smtp.EmailBackend when SMTP is configured)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@daimoma.example.com
FRONTEND_BASE_URL=https://daimoma.example.com

# Session & token policy (D-009)
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=86400
INVITATION_TOKEN_HOURS=48
RECOVERY_TOKEN_MINUTES=30
