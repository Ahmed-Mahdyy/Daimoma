# Local development only — copy to .env. Never commit real secrets.
# Django settings read these via django-environ (backend/config/).

DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# SPA origins allowed to POST (CSRF Origin check)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://frontend:5173

# PostgreSQL container
POSTGRES_DB=daimoma
POSTGRES_USER=daimoma
POSTGRES_PASSWORD=daimoma_dev_password
DATABASE_URL=postgres://daimoma:daimoma_dev_password@db:5432/daimoma

# Email: console backend in development (owner-approved local mail sink).
# Invitations/recovery links print to `docker compose logs backend`.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Production SMTP — set all of these via environment/secrets, never in source.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.example.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=daimoma@example.com
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=1          # STARTTLS (port 587). Mutually exclusive:
# DJANGO_EMAIL_USE_SSL=0          # implicit TLS (port 465) — never both true.
# DJANGO_EMAIL_TIMEOUT=30
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.tld
# DJANGO_SERVER_EMAIL=errors@yourdomain.tld
# FRONTEND_BASE_URL=https://app.yourdomain.tld

# Session/security policy (D-009)
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=86400
INVITATION_TOKEN_HOURS=48
RECOVERY_TOKEN_MINUTES=30
