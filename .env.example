# Local development only — copy to .env. Never commit real secrets.
# Django settings read these via django-environ (backend/config/).

DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL container
POSTGRES_DB=daimoma
POSTGRES_USER=daimoma
POSTGRES_PASSWORD=daimoma_dev_password
DATABASE_URL=postgres://daimoma:daimoma_dev_password@db:5432/daimoma

# Email: console backend in development (owner-approved local mail sink)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Session/security policy (D-009)
SESSION_IDLE_SECONDS=7200
SESSION_ABSOLUTE_SECONDS=86400
INVITATION_TOKEN_HOURS=48
RECOVERY_TOKEN_MINUTES=30
