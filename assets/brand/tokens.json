{
  "$schema": "design-tokens draft",
  "meta": {
    "product": "Daimoma",
    "version": "0.1.0",
    "status": "approved",
    "notes": "Semantic tokens; map to CSS custom properties now, Tailwind theme in phase 002. Contrast pairs measured; see usage.md."
  },
  "color": {
    "brand": {
      "primary": { "value": "#0F6B63", "on": "#FFFFFF", "usage": "primary actions, nav active, brand mark" },
      "primaryHover": { "value": "#0B5650", "on": "#FFFFFF" },
      "primarySubtle": { "value": "#E0F2F0", "on": "#0B4B45" },
      "accent": { "value": "#2BD9C7", "usage": "dark-mode mark, highlights" },
      "gold": { "value": "#C9A227", "usage": "check-mark accent in the approved logo, sparse highlights" }
    },
    "semantic": {
      "success": { "value": "#1E7F4F", "on": "#FFFFFF", "subtle": "#E3F4EA" },
      "warning": { "value": "#8A5A00", "on": "#FFFFFF", "subtle": "#FDF0D5" },
      "error": { "value": "#B42318", "on": "#FFFFFF", "subtle": "#FDECEA" },
      "info": { "value": "#175CD3", "on": "#FFFFFF", "subtle": "#E8F0FE" }
    },
    "neutral": {
      "surface": { "value": "#FFFFFF" },
      "surfaceAlt": { "value": "#F5F7FA" },
      "border": { "value": "#D7DEE6" },
      "text": { "value": "#102A43" },
      "textMuted": { "value": "#52667A" },
      "textInverse": { "value": "#F5F7FA" }
    },
    "dark": {
      "surface": { "value": "#102A43" },
      "surfaceAlt": { "value": "#1B3A57" },
      "border": { "value": "#33506B" },
      "text": { "value": "#F5F7FA" },
      "textMuted": { "value": "#B8C4D1" }
    }
  },
  "font": {
    "latin": { "family": "Inter", "fallback": "'Segoe UI', Arial, sans-serif", "license": "OFL-1.1 (verify at download)" },
    "arabic": { "family": "IBM Plex Sans Arabic", "fallback": "'Noto Sans Arabic', Tahoma, sans-serif", "license": "OFL-1.1 (verify at download)" },
    "scale": { "xs": "0.75rem", "sm": "0.875rem", "md": "1rem", "lg": "1.125rem", "xl": "1.375rem", "2xl": "1.75rem" }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "8": "48px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
  "stroke": { "focus": "2px solid #175CD3" },
  "breakpoint": { "mobile": "360px", "tablet": "768px", "desktop": "1440px" },
  "motion": { "duration": "150ms", "respect": "prefers-reduced-motion" }
}
